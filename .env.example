# --- REQUIRED: AI model config (no defaults in code — entrypoint fails if missing) ---
# The bot talks to the self-hosted 9router gateway (OpenAI-compatible endpoint),
# not to a built-in Hermes provider. Values below are 9router COMBO names (they
# contain no "/"), so combo members can be re-tuned on the gateway side without
# editing this file.
HERMES_MODEL=hermes-chat
HERMES_PROVIDER=custom
# Internal, container-to-container endpoint: docker-compose joins this service to
# 9router's own network, where the gateway answers to `router9`, so bot traffic
# never leaves the host. That keeps Cloudflare out of the path entirely — its
# Browser Integrity Check answers the OpenAI SDK's User-Agent with error 1010
# (HTTP 403) on the public hostname. Use https://9router.olelukoie.online/v1 only
# for clients OUTSIDE the host (local opencode, dashboard).
HERMES_BASE_URL=http://router9:20128/v1
HERMES_API_MODE=chat_completions
# Optional context-window override. Hermes resolves a model's context length
# dynamically, but a 9router COMBO returns no metadata from /v1/models, so the
# probe fails and Hermes falls back to its hardcoded 256k default — too large
# for the hermes-chat combo, whose primary member (ocg/deepseek-flash) is 128k.
# Compaction would then trigger too late and risk provider-side context-overflow
# errors. Set the smallest window among the members of the combos this bot may
# hit; leave it empty to let Hermes decide.
HERMES_CONTEXT_LENGTH=128000
# Required: 9router API key (dashboard -> API keys). Used by Hermes for the main
# model (model.api_key) and by the image_gen/9router plugin for image requests.
ROUTER9_API_KEY=
HERMES_TIMEZONE=Asia/Ho_Chi_Minh
# MCP hub repo, cloned/pulled at boot (no default — required)
MCP_HUB_REPO_URL=https://github.com/ndq1801/slave_mcps.git

# --- Optional: auxiliary vision model for image analysis ---
# Needed when HERMES_MODEL is text-only: incoming photos are described by this
# vision-capable model via the vision_analyze tool. Point it at a 9router combo
# whose members can take image input (e.g. ocg/glm-5.3-flash). Runs on the same
# provider/endpoint as the main model (HERMES_PROVIDER/HERMES_BASE_URL), so no
# separate endpoint is needed.
HERMES_VISION_MODEL=hermes-vision

# --- Optional: image generation ---
# Uses this repo's own image_gen plugin (plugins/image_gen/9router), which POSTs to
# {ROUTER9_BASE_URL}/images/generations. HERMES_IMAGE_MODEL is a 9router combo
# name; generation only produces images once that combo contains a real image
# model (a text model placeholder makes the gateway return no image data).
HERMES_IMAGE_MODEL=hermes-image

# --- Conversation titling ---
# DISABLED by default (auto-titling would use a fast/cheap provider model
# instead of the main model). Only opt in to use the main model:
#   HERMES_TITLE_GENERATION=main
# Unset (or anything else) = disabled.

# --- Telegram bot (from @BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:AA...-token
# Comma-separated Telegram user IDs allowed to chat with the bot.
# Leave empty = everyone (NOT recommended).
TELEGRAM_ALLOWED_USERS=
# Your own Telegram user ID: cron deliveries go here and finlog uses it as
# the default user. MUST be set or the bot stays silent.
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=ErrandBoy

# --- MCP: mcp-daily-report (Daily Report web app credentials) ---
DAILY_REPORT_BASE_URL=https://daily-report.wpdevelop.online
DAILY_REPORT_USERNAME=you@example.com
DAILY_REPORT_PASSWORD=your_password
DAILY_REPORT_LOGIN_FIELD=email

# --- Postgres (bundled finlog DB service) ---
# Password for the local postgres:17 service. docker-compose interpolates it
# into both the postgres service and the container's DATABASE_URL (which
# overrides the value below), so it must be set for the two to match.
POSTGRES_PASSWORD=

# --- MCP: mcp-finlog (shared FinlogBot Postgres) ---
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- MCP: mcp-obsidian (Obsidian vault as a folder of markdown notes) ---
# Absolute path INSIDE the container to the vault folder (persisted via the
# vault_data volume). Sync the vault however you like (Obsidian Git push+pull,
# rclone, etc.).
OBSIDIAN_VAULT_PATH=/root/obsidian-vault

# --- Dev projects root INSIDE the container (persisted via projects_data) ---
# Agent-editable code checked out here survives redeploys. Single source for
# both docker-compose (volume mount target) and the access-control plugin.
DEV_PROJECTS_PATH=/root/projects

# --- Persistent CLI tool root INSIDE the container (host bind /srv/errandboy/tools) ---
# Agent-installed CLI tools live here (bin/ is first on PATH). Single source
# for docker-compose (mount target), entrypoint (mkdir + PATH) and the
# access-control plugin.
TOOLS_ROOT=/opt/tools

# --- Hermes home INSIDE the container (persisted via hermes_data) ---
# Gateway runtime state (config, skills, sessions, logs). Single source for
# docker-compose (mount target + GIT_CONFIG_GLOBAL) and entrypoint.
# NOTE: the image bakes its venv at ${HERMES_HOME}/hermes-agent/venv/bin — if
# you move this, rebuild the image too.
HERMES_HOME=/root/.hermes

# --- MCP: mcp-calendar (Google Calendar via OAuth 2.0, desktop-app credentials) ---
# Credentials from https://console.cloud.google.com -> APIs & Services -> Credentials.
# Refresh token comes from the OAuth consent flow.
GOOGLE_CALENDAR_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-secret
GOOGLE_CALENDAR_REFRESH_TOKEN=your-refresh-token
# Calendar id to manage ('primary' = the account's main calendar).
GOOGLE_CALENDAR_ID=primary
# IANA timezone used for queries.
GOOGLE_CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh

# --- Optional ---
# Web search via Brave (enables the brave-search MCP server)
BRAVE_SEARCH_API_KEY=
# Jina Reader API key (https://jina.ai/reader/) for web page extraction (web_extract)
JINA_API_KEY=
# Override the plugin's allowed-user list (defaults to TELEGRAM_ALLOWED_USERS)
# ACCESS_CONTROL_ALLOWED_USERS=
